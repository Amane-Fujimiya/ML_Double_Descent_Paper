\@writefile{toc}{\contentsline {subsubsection}{Model-wise double descent, \cite  {belkin_reconciling_2019}}{124}{subsubsection*.43}\protected@file@percent }
\newlabel{fig:FuCoNN_MNIST_REUSEWEIGHT}{{5.1a}{124}{Double descent risk curve for a fully connected neural network on MNIST. Training and test risks of a network with a single layer of $H$ hidden units, learned on a subset of MNIST ($n=4\cdot 10^3$, $d=784$, $K=10$ classes). The number of parameters is $(d+1)\cdot H + (H+1)\cdot K$. The interpolation threshold (black dotted line) is observed at $n\cdot K$. Taken from \cite {belkin_reconciling_2019}}{figure.caption.44}{}}
\newlabel{sub@fig:FuCoNN_MNIST_REUSEWEIGHT}{{a}{124}{Double descent risk curve for a fully connected neural network on MNIST. Training and test risks of a network with a single layer of $H$ hidden units, learned on a subset of MNIST ($n=4\cdot 10^3$, $d=784$, $K=10$ classes). The number of parameters is $(d+1)\cdot H + (H+1)\cdot K$. The interpolation threshold (black dotted line) is observed at $n\cdot K$. Taken from \cite {belkin_reconciling_2019}}{figure.caption.44}{}}
\newlabel{fig:forest-mnist-main}{{5.1b}{124}{Double descent risk curve for random forests on MNIST. The double descent risk curve is observed for random forests with increasing model complexity trained on a subset of MNIST ($n=10^4$, $10$ classes). Model complexity is controlled by the number of trees $N_\mathsf {tree}$ and the maximum number of leaves allowed for each tree $N_\mathsf {leaf}^{\mathsf {max}}$}{figure.caption.44}{}}
\newlabel{sub@fig:forest-mnist-main}{{b}{124}{Double descent risk curve for random forests on MNIST. The double descent risk curve is observed for random forests with increasing model complexity trained on a subset of MNIST ($n=10^4$, $10$ classes). Model complexity is controlled by the number of trees $N_\mathsf {tree}$ and the maximum number of leaves allowed for each tree $N_\mathsf {leaf}^{\mathsf {max}}$}{figure.caption.44}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5.1}{\ignorespaces \textbf  {Double descent risk curves on MNIST for different model classes.} Comparison of the phenomenon in (left) a fully connected neural network and (right) a random forest as model complexity increases. We use results from \cite  {belkin_reconciling_2019}, however, extension is rather natural.}}{124}{figure.caption.44}\protected@file@percent }
\newlabel{fig:mnist_double_descent_comparison}{{5.1}{124}{\textbf {Double descent risk curves on MNIST for different model classes.} Comparison of the phenomenon in (left) a fully connected neural network and (right) a random forest as model complexity increases. We use results from \cite {belkin_reconciling_2019}, however, extension is rather natural}{figure.caption.44}{}}
